# Copy to ../.env or project .env and fill only the values you use.
OPENAI_API_KEY=nvapi-your-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.1-70b-instruct
PORT=8000

# Optional live Discord crawler. Never commit a real token or crawled messages.
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional comma-separated allowlists. Leave blank to allow every guild/channel visible to the bot.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
