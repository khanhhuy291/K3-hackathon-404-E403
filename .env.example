# Copy this file to the repository-root .env. Never commit real keys or Discord data.

# Optional NVIDIA/OpenAI-compatible provider used by the retained agent architecture.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.1-70b-instruct
PORT=8000

# Optional live Discord crawler. Enable Message Content Intent in Discord Developer Portal.
DISCORD_BOT_TOKEN=
# Use at least one scope below, or explicitly set DISCORD_ALLOW_ALL=1 for a private test bot.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOW_ALL=0
# Optional institutional announcement bot IDs that are safe to ingest.
DISCORD_TRUSTED_BOT_IDS=
